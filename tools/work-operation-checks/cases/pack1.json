  "difficulties": [
    {
      "case": "T01",
      "facts": [
        "T01.01",
        "T01.03"
      ],
      "problem": "T01.01 只能支持事务式重载这一点；文件初始化、模块导出和无关仓库插件能力要到 T01.03 才作为保留项出现。若在初始对象或 T01.01 就写入完整 parts，会把后来的处置提前到起点，制造未卜先知。",
      "handling": "T01.01 只建立 transactional_reload 一个组成项；T01.03 先补记保留项的组成边界，再在同一事实步骤执行 partial_revert，只把 transactional_reload 标为 withdrawn。补记动作是记录可见性造成的编码步骤，不声称这些保留项在 8 月已按该名称存在。"
    },
    {
      "case": "T01",
      "facts": [
        "T01.02",
        "T01.04"
      ],
      "problem": "T01.02 是记录下来的撤回决定，T01.04 才是撤回提交和消费者适配提交。若把 T01.02 直接写成已撤回，会把决定冒充为运行现场已经完成的清理。",
      "handling": "T01.02 只把尝试标为 withdrawal_recorded，保留未落地说明；T01.03 的 partial_revert 明确是记录范围的退出；T01.04 才 close 旧尝试并记录撤回提交。这样决定、记录范围和提交事件分开。"
    },
    {
      "case": "T01",
      "facts": [
        "T01.05"
      ],
      "problem": "消费者审查实际激活结果是一项产品行为责任，不是新的开发工作项；若另建一个 consumer work，会凭空造出上游没有的工作边界和负责人。",
      "handling": "把责任变化放进 T01/loader 契约的 responsibility_change 和 consumer_responsibility 字段，并让 T01/goal 与 T01/work 保持 open。没有新增消费者工作身份，也没有把责任转移写成已完成事件。"
    },
    {
      "case": "T03",
      "facts": [
        "T03.01",
        "T03.02",
        "T03.03"
      ],
      "problem": "第一次流式管线已合入并同日撤回，第二次流式实现也出现了，但底稿明确说两次实现的对应关系和复用范围待查。使用 rework 会自动建立同目标新尝试和历史参考关系，正好越过这条未知边界。",
      "handling": "分别建立 T03/stream1 和 T03/stream2；T03/stream1 用 close 记录同日撤回和未知理由；T03/stream2 只记录 reported_merged，并把 relationship_to_attempt1 与 reuse_scope 写成 unknown。没有使用 rework，也不把两次实现连成同一次返工。"
    },
    {
      "case": "T03",
      "facts": [
        "T03.04"
      ],
      "problem": "116 MB 会话耗尽 16 GB Node 进程的作者报告说的是整份转换实现，但没有说明它对应 #2698、#3585 还是另一实现。直接挂到某个 work 上会虚构测量对象。",
      "handling": "建立 T03/mem-report 报告对象，保留 measurement 和 author_reported 归属，同时把 implementation_identity 明确写成 unknown；T03/work 只记录内存失败待复核，T03/protocol 在采用分阶段设计时引用该报告为证据，不把失败归给任一提交。"
    },
    {
      "case": "T03",
      "facts": [
        "T03.05",
